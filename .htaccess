RewriteEngine On

# Do not rewrite real files or directories, such as public assets.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^admin/dashboard/?$ index.php?page=dashboard [L,QSA]
RewriteRule ^admin/staff/?$ index.php?page=staff [L,QSA]
RewriteRule ^admin/staff/create/?$ index.php?page=create-staff [L,QSA]
RewriteRule ^admin/staff/edit/([0-9]+)/?$ index.php?page=edit-staff&id=$1 [L,QSA]
RewriteRule ^admin/staff/delete/([0-9]+)/?$ index.php?page=delete-staff&id=$1 [L,QSA]
